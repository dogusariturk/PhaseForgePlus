$ Synthetic Pt-W system for the hinge penalty tests. Not an assessment.
ELEMENT VA VACUUM 0 0 0 !
ELEMENT PT FCC_A1 0.19508 5723.712 41.6308 !
ELEMENT W BCC_A2 0.18385 4970 32.6176 !
FUNCTION VV0000 298.15 -2000; 6000 N !
FUNCTION VV0001 298.15 -60000; 6000 N !
FUNCTION VV0002 298.15 -5000; 6000 N !
FUNCTION VV0003 298.15 20000; 6000 N !
TYPE_DEFINITION % SEQ * !
PHASE SOLUTION % 1 1 !
CONSTITUENT SOLUTION :PT,W: !
PARAMETER G(SOLUTION,PT;0) 298.15 0; 6000 N !
PARAMETER G(SOLUTION,W;0) 298.15 0; 6000 N !
PARAMETER G(SOLUTION,PT,W;0) 298.15 VV0000; 6000 N !
PHASE SPURIOUS % 2 1 1 !
CONSTITUENT SPURIOUS :PT:W: !
PARAMETER G(SPURIOUS,PT:W;0) 298.15 2*VV0001; 6000 N !
PHASE ORDERED % 2 1 1 !
CONSTITUENT ORDERED :PT,VA,W:PT,VA,W: !
PARAMETER G(ORDERED,PT:PT;0) 298.15 0; 6000 N !
PARAMETER G(ORDERED,W:W;0) 298.15 0; 6000 N !
PARAMETER G(ORDERED,PT:W;0) 298.15 VV0002; 6000 N !
PARAMETER G(ORDERED,W:PT;0) 298.15 VV0002; 6000 N !
PARAMETER G(ORDERED,VA:VA;0) 298.15 VV0003; 6000 N !
PARAMETER G(ORDERED,PT:VA;0) 298.15 VV0003; 6000 N !
PARAMETER G(ORDERED,VA:PT;0) 298.15 VV0003; 6000 N !
PARAMETER G(ORDERED,W:VA;0) 298.15 VV0003; 6000 N !
PARAMETER G(ORDERED,VA:W;0) 298.15 VV0003; 6000 N !
